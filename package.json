{
  "name": "dsh-linux-desktop-entry",
  "version": "0.1.0",
  "private": true,
  "description": "Install, repair or remove the Linux desktop entrance for the DeepSeek Harness Web GUI from inside the harness, and open the GUI in an app window.",
  "license": "MIT",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "tools/selftest-plugin.mjs",
    "vendor/",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
